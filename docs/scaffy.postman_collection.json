    {
      "name": "Analyzer",
      "description": "Pipeline maturity analysis (`/api/analyze`).",
      "item": [
        {
          "name": "Analyze pipeline (upload YAML)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analyze"
              ]
            },
            "description": "Upload a GitHub Actions or GitLab CI YAML file (.yml/.yaml). Returns a maturity report with an overall level (1-5) and per-dimension scores (build, test, code analysis, security scanning, artifacts, deployment, notifications).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/ci.yml"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Recommendations",
      "description": "LLM-backed suggestions (`/api/recommend`).",
      "item": [
        {
          "name": "Recommend (whole report)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recommend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommend"
              ]
            },
            "description": "Send an AnalysisResponse (the analyzer output). Returns prioritized AI improvement suggestions.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"GITHUB_ACTIONS\",\n  \"overallScore\": 12.0,\n  \"overallLevel\": 2,\n  \"overallStatus\": \"EVALUATED\",\n  \"dimensions\": [\n    {\n      \"dimension\": \"build\",\n      \"capabilityScores\": [],\n      \"score\": 4.0,\n      \"level\": 2,\n      \"status\": \"EVALUATED\"\n    },\n    {\n      \"dimension\": \"test\",\n      \"capabilityScores\": [],\n      \"score\": 0.0,\n      \"level\": 1,\n      \"status\": \"EVALUATED\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Recommend fix for a finding",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recommend/finding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommend",
                "finding"
              ]
            },
            "description": "Request a concrete fix for a single finding, including a proposed edit to the workflow file.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"analysisRunId\": null,\n  \"provider\": \"github-actions\",\n  \"workflowPath\": \".github/workflows/ci.yml\",\n  \"workflowContent\": \"name: CI\\non: [push]\\njobs:\\n  build:\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@v4\\n\",\n  \"finding\": {\n    \"ruleId\": \"TESTS_PRESENT\",\n    \"ruleLabel\": \"Automated tests\",\n    \"ruleDescription\": \"No test step detected.\",\n    \"dimension\": \"test\",\n    \"capability\": \"automated-tests\",\n    \"type\": \"MISSING\",\n    \"evidence\": \"\",\n    \"location\": \".github/workflows/ci.yml\",\n    \"startLine\": null,\n    \"endLine\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Apply fix (commit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Workspace-Id",
                "value": "{{workspaceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recommend/finding/apply",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommend",
                "finding",
                "apply"
              ]
            },
            "description": "(auth) Commit an approved fix to the workflow file of a connected repository via the user's GitHub connection. Requires the X-Workspace-Id header (active workspace).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"analysisRunId\": null,\n  \"finding\": {\n    \"ruleId\": \"TESTS_PRESENT\",\n    \"ruleLabel\": \"Automated tests\",\n    \"ruleDescription\": \"No test step detected.\",\n    \"dimension\": \"test\",\n    \"capability\": \"automated-tests\",\n    \"type\": \"MISSING\",\n    \"evidence\": \"\",\n    \"location\": \".github/workflows/ci.yml\",\n    \"startLine\": null,\n    \"endLine\": null\n  },\n  \"workflowPath\": \".github/workflows/ci.yml\",\n  \"workflowContent\": \"name: CI\\n...full file...\\n\",\n  \"commitMessage\": \"ci: add automated test step (via Scaffy)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
