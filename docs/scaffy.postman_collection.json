{
  "info": {
    "name": "Scaffy API",
    "description": "Scaffy REST API \u2014 project initializer and CI/CD maturity analyzer.\n\nSet the `baseUrl` collection variable to your environment:\n- Local backend: `http://localhost:8080`\n- Compose stack: `http://localhost` (or your domain, behind Traefik)\n\n**Auth:** Scaffy uses OAuth2 login (Google / GitHub / GitLab). After signing in via the browser, the backend sets HTTP-only auth cookies. For authenticated endpoints, run requests with those cookies present (e.g. import them, or use Postman's browser-based flow). Endpoints marked *(auth)* require a valid session.\n\nGenerated by reading the scaffy-be controllers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "repositoryId",
      "value": ""
    },
    {
      "key": "workspaceId",
      "value": ""
    },
    {
      "key": "publicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Service liveness.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Returns {\"status\":\"ok\", ...}. Public."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Initializer",
      "description": "Project scaffold generation (`/api/init`).",
      "item": [
        {
          "name": "Get stack catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/init/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "init",
                "catalog"
              ]
            },
            "description": "Public. Lists supported frontends (angular, vue, react), backends (spring-boot, dotnet, nestjs), pipelines (github-actions, gitlab-ci), version & runtime presets, and maturity presets."
          },
          "response": []
        },
        {
          "name": "Generate project (sync ZIP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/init",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "init"
              ]
            },
            "description": "Public. Generates a scaffold and returns it directly as application/zip. Simple flow (Spring Boot + Angular).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"demo-app\",\n  \"frontend\": \"angular\",\n  \"backend\": \"spring-boot\",\n  \"pipeline\": \"github-actions\",\n  \"includeDocker\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create generation job (async)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/init/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "init",
                "jobs"
              ]
            },
            "description": "Queues an async generation job. Returns 202 Accepted with the job. Optional Idempotency-Key header de-duplicates retries.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"demo-app\",\n  \"frontend\": \"angular\",\n  \"frontendVersion\": \"18\",\n  \"frontendRuntime\": \"node-20\",\n  \"backend\": \"spring-boot\",\n  \"backendVersion\": \"4.0.6\",\n  \"backendRuntime\": \"java-25\",\n  \"pipeline\": \"github-actions\",\n  \"pipelineMaturity\": \"standard\",\n  \"includeDocker\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get job status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/init/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "init",
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Poll the status of a generation job (queued / running / succeeded / failed) with log lines."
          },
          "response": []
        },
        {
          "name": "Download job artifact",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/init/jobs/{{jobId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "init",
                "jobs",
                "{{jobId}}",
                "download"
              ]
            },
            "description": "Downloads the generated ZIP once the job has succeeded. 409/structured error otherwise."
          },
          "response": []
        },
        {
          "name": "Generation history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/init/history?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "init",
                "history"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "(auth) Recent generation jobs for the signed-in user."
          },
          "response": []
        }
      ]
    },
