FROM node:24-alpine AS build
WORKDIR /workspace
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
RUN npm run build

FROM node:24-alpine
WORKDIR /app
RUN npm install -g serve
COPY --from=build /workspace/{{frontendDistPath}} ./dist
EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]
